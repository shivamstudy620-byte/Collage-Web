# Server Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET

# Cloudinary Media Storage Credentials
CLOUDINARY_NAME=YOUR_CLOUDINARY_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_NEW_ROTATED_CLOUDINARY_API_SECRET

# Production Frontend URL for Strict CORS
# Example: https://rksd-college.netlify.app
FRONTEND_URL=https://YOUR_NETLIFY_SITE.netlify.app

# Optional: Path to local SQLite DB backup for migration
DATABASE_PATH=./college.db
